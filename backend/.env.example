# Copier ce fichier en .env (jamais commité — voir .gitignore) pour
# lancer le backend sans Docker, en pointant vers une base locale.
# Avec docker-compose.yml, ces valeurs sont déjà fournies au conteneur
# et ce fichier n'est là qu'à titre de documentation.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/siegevif
SESSION_SECRET=change-moi-pour-une-vraie-valeur-aleatoire
PORT=3000
