# Copiez ce fichier en .env (Copy-Item .env.example .env), puis remplacez les valeurs bidon.
# .env ne doit jamais être commité.

# Adresse de la base PostgreSQL pour npm run dev (avec Docker, docker-compose.yml fixe déjà la sienne).
DATABASE_URL=postgres://parterre:parterre@localhost:5432/parterre
# Clé secrète qui signe les jetons de connexion : mettez une longue valeur au hasard.
JWT_SECRET=changez-cette-cle-avant-deploiement
# Port du serveur avec npm run dev (Docker utilise 3000).
PORT=4000
# Adresse du site (retour après la connexion GitHub, WebSocket). Docker : http://localhost:3000. npm run dev : http://localhost:5173.
CLIENT_ORIGIN=http://localhost:3000
# Nom du compte gestionnaire créé au démarrage.
INITIAL_ADMIN_NAME=Gestionnaire Demo
# Courriel du compte gestionnaire créé au démarrage.
INITIAL_ADMIN_EMAIL=gestionnaire@parterre.demo
# Mot de passe du compte gestionnaire (12 caractères minimum).
INITIAL_ADMIN_PASSWORD=demo-gestionnaire-2026
# Nom du compte spectateur de démo créé au démarrage.
DEMO_SPECTATOR_NAME=Spectateur Demo
# Courriel du compte spectateur de démo créé au démarrage.
DEMO_SPECTATOR_EMAIL=spectateur@parterre.demo
# Mot de passe du compte spectateur de démo.
DEMO_SPECTATOR_PASSWORD=demo-spectateur-2026
# Client ID de votre OAuth App GitHub (GitHub > Settings > Developer settings > OAuth Apps).
GITHUB_OAUTH_CLIENT_ID=remplacez-par-votre-client-id
# Client secret de la même OAuth App. Ne le partagez jamais, ne le commitez jamais.
GITHUB_OAUTH_CLIENT_SECRET=remplacez-par-votre-client-secret
# Adresse de retour de GitHub, identique à celle des réglages de l'OAuth App.
# Docker : http://localhost:3000/api/auth/github/callback. npm run dev : http://localhost:4000/api/auth/github/callback.
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/github/callback